{
  "id": "studio_minimal_clean",
  "name": "Studio Minimal Clean",
  "description": "Ultra-clean Scandinavian aesthetic with dark slate matte backdrop, crisp emerald and titanium accents, and unobstructed clean speaker view.",
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 60,
    "targetDurationSec": 50
