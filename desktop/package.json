{
  "name": "openshorts-desktop",
  "version": "4.2.0",
  "description": "OpenShorts - Open Source Self-Hosted Clip Generator",
  "main": "dist-electron/main/index.js",
  "author": "OpenShorts Team",
  "license": "MIT",
  "scripts": {
    "build:electron": "node ../frontend/node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:frontend": "py -3 scripts/build_frontend.py",
    "build:backend": "py -3 scripts/build_backend.py",
    "download:binaries": "py -3 scripts/download_binaries.py",
    "build:all": "py -3 scripts/package_desktop.py",
    "package": "electron-builder --win",
    "package:portable": "electron-builder --win portable",
    "package:dir": "electron-builder --win --dir",
    "start": "tsc -p tsconfig.json && electron dist-electron/main/index.js"
  },
  "dependencies": {
    "get-port": "^7.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "@types/node": "^22.8.7"
  }
}
