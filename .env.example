# ==========================================
# OpenShort - Environment Configuration
# ==========================================
# Copy this file to .env:
#   cp .env.example .env
#
# Get a free Gemini API Key at:
#   https://aistudio.google.com/app/apikey
# ==========================================

# Required for AI Viral Clip Discovery & Motion Choreography
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (Options: gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.8-flash)
SELECTED_GEMINI_MODEL=gemini-2.5-flash

# Optional: Claude / Anthropic API Key (if using Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Configuration (Defaults to 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000
